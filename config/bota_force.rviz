Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Force1
    Splitter Ratio: 0.5
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Enabled: true
      Reference Frame: <Fixed Frame>
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.3
    - Class: rviz/Axes
      Name: Sensor Axes
      Enabled: true
      Length: 0.1
      Radius: 0.005
      Reference Frame: <Fixed Frame>
    - Class: rviz/Marker
      Name: Force
      Enabled: true
      Marker Topic: /bota/force_marker
      Queue Size: 10
      Namespaces:
        bota_force: true
    - Class: rviz/WrenchStamped
      Name: Wrench (raw, unfiltered)
      Enabled: false
      Topic: /bota/wrench
      Force Arrow Scale: 0.02
      Torque Arrow Scale: 0.2
      Arrow Width: 0.3
      Alpha: 0.6
      Force Color: 204; 51; 51
      Torque Color: 204; 204; 51
      Queue Size: 10
      History Length: 1
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: bota_ft_sensor
    Frame Rate: 30
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 1.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.5
      Yaw: 0.8
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
